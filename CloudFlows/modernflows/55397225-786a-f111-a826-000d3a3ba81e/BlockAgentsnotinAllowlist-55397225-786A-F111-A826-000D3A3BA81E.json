{
  "properties": {
    "connectionReferences": {},
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "a7d1de60-c768-46fb-8847-5dcb2eb7824e"
          },
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {},
              "required": []
            }
          }
        }
      },
      "actions": {
        "Initialize_allowlist_agent_ids": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "680c48d2-ea14-4a7d-8042-ccd9b9eca70c"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "AllowlistAgentIds",
                "type": "array",
                "value": [
                  "P_04bd11c3-6ac7-7b55-6c0a-4a99918be9f1",
                  "P_8d830dc1-9a14-1528-1182-c8e3be94cf5a",
                  "P_15f67c5b-bfb1-fbd9-043a-cbb047bb7bd0",
                  "P_54c3f25e-3850-e1e6-231a-aa85fbe9447b",
                  "P_5b99927c-dcd2-3654-aacb-f8d82a980c83",
                  "P_552e6eda-fc18-7fb9-0ef6-1bf2de3393e4",
                  "P_8cfc4e6f-267e-db15-c6e7-3fc47a54f61e"
                ]
              }
            ]
          }
        },
        "Initialize_page_url": {
          "runAfter": {
            "Initialize_allowlist_agent_ids": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "PageUrl",
                "type": "string",
                "value": "https://graph.microsoft.com/beta/copilot/admin/catalog/packages?$filter=supportedHosts/any(h:h eq 'Copilot')"
              }
            ]
          }
        },
        "Initialize_blocked_agents": {
          "runAfter": {
            "Initialize_page_url": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "BlockedAgents",
                "type": "array",
                "value": []
              }
            ]
          }
        },
        "Initialize_allowed_agents": {
          "runAfter": {
            "Initialize_blocked_agents": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "AllowedAgents",
                "type": "array",
                "value": []
              }
            ]
          }
        },
        "Initialize_draft_agents": {
          "runAfter": {
            "Initialize_allowed_agents": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "DraftAgents",
                "type": "array",
                "value": []
              }
            ]
          }
        },
        "Until_all_pages_processed": {
          "runAfter": {
            "Initialize_draft_agents": [
              "Succeeded"
            ]
          },
          "type": "Until",
          "expression": "@equals(variables('PageUrl'), '')",
          "limit": {
            "count": 100,
            "timeout": "PT1H"
          },
          "actions": {
            "Get_agents_page": {
              "runAfter": {},
              "type": "Http",
              "inputs": {
                "method": "GET",
                "uri": "@{variables('PageUrl')}",
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 3,
                  "interval": "PT30S"
                }
              }
            },
            "For_each_agent": {
              "runAfter": {
                "Get_agents_page": [
                  "Succeeded"
                ]
              },
              "type": "Foreach",
              "foreach": "@coalesce(body('Get_agents_page')?['value'], createArray())",
              "operationOptions": "Sequential",
              "actions": {
                "If_agent_is_in_allowlist": {
                  "runAfter": {},
                  "type": "If",
                  "expression": "@contains(variables('AllowlistAgentIds'), items('For_each_agent')?['id'])",
                  "actions": {
                    "Append_to_allowed_agents": {
                      "runAfter": {},
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "AllowedAgents",
                        "value": {
                          "id": "@{items('For_each_agent')?['id']}",
                          "displayName": "@{coalesce(items('For_each_agent')?['displayName'], '(no name)')}",
                          "status": "allowed"
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "If_agent_is_draft": {
                        "runAfter": {},
                        "type": "If",
                        "expression": "@contains(toLower(string(coalesce(items('For_each_agent')?['publishingStatus'], items('For_each_agent')?['publicationStatus'], items('For_each_agent')?['publishingState'], items('For_each_agent')?['state'], items('For_each_agent')?['status'], items('For_each_agent')?['packageStatus'], items('For_each_agent')?['deploymentStatus'], ''))), 'draft')",
                        "actions": {
                          "Append_to_draft_agents": {
                            "runAfter": {},
                            "type": "AppendToArrayVariable",
                            "inputs": {
                              "name": "DraftAgents",
                              "value": {
                                "id": "@{items('For_each_agent')?['id']}",
                                "displayName": "@{coalesce(items('For_each_agent')?['displayName'], '(no name)')}",
                                "status": "draft"
                              }
                            }
                          }
                        },
                        "else": {
                          "actions": {
                            "If_agent_is_already_blocked": {
                              "runAfter": {},
                              "type": "If",
                              "expression": "@equals(items('For_each_agent')?['isBlocked'], true)",
                              "actions": {
                                "Append_already_blocked_agent_to_blocked_agents": {
                                  "runAfter": {},
                                  "type": "AppendToArrayVariable",
                                  "inputs": {
                                    "name": "BlockedAgents",
                                    "value": {
                                      "id": "@{items('For_each_agent')?['id']}",
                                      "displayName": "@{coalesce(items('For_each_agent')?['displayName'], '(no name)')}",
                                      "status": "alreadyBlocked"
                                    }
                                  }
                                }
                              },
                              "else": {
                                "actions": {
                                  "Block_agent": {
                                    "runAfter": {},
                                    "type": "Http",
                                    "inputs": {
                                      "method": "POST",
                                      "uri": "@{concat('https://graph.microsoft.com/beta/copilot/admin/catalog/packages/', items('For_each_agent')?['id'], '/block')}",
                                      "authentication": "@parameters('$authentication')",
                                      "retryPolicy": {
                                        "type": "exponential",
                                        "count": 3,
                                        "interval": "PT30S"
                                      }
                                    }
                                  },
                                  "Append_to_blocked_agents": {
                                    "runAfter": {
                                      "Block_agent": [
                                        "Succeeded"
                                      ]
                                    },
                                    "type": "AppendToArrayVariable",
                                    "inputs": {
                                      "name": "BlockedAgents",
                                      "value": {
                                        "id": "@{items('For_each_agent')?['id']}",
                                        "displayName": "@{coalesce(items('For_each_agent')?['displayName'], '(no name)')}",
                                        "status": "blocked"
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "Set_next_page_url": {
              "runAfter": {
                "For_each_agent": [
                  "Succeeded"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "PageUrl",
                "value": "@{coalesce(body('Get_agents_page')?['@odata.nextLink'], '')}"
              }
            }
          }
        },
        "Compose_results": {
          "runAfter": {
            "Until_all_pages_processed": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": {
            "blocked": "@{variables('BlockedAgents')}",
            "allowed": "@{variables('AllowedAgents')}",
            "draft": "@{variables('DraftAgents')}"
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}
